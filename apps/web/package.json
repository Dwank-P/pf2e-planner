{
  "name": "@pf2e-planner/web",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build && node scripts/generate-build-metadata.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/db.test.mjs tests/rich-text.test.mjs tests/level-formulas.test.mjs tests/eligibility.test.mjs tests/leveler-progression.test.mjs",
    "smoke": "node --test tests/smoke.test.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "sanitize-html": "^2.17.0",
    "htmlparser2": "^10.0.0",
    "dom-serializer": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
