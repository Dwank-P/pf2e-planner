{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PF2e Planner read-only world metadata preview",
  "description": "Diagnostic snapshot only; NOT an authenticated sync payload.",
  "type": "object",
  "required": [
    "format",
    "version",
    "generatedAt",
    "world",
    "system",
    "leveler",
    "itemPacks"
  ],
  "properties": {
    "format": {
      "const": "pf2e-planner-world-metadata"
    },
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "world": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "system": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "leveler": {
      "type": "object",
      "required": [
        "installed",
        "active",
        "version",
        "settings"
      ],
      "properties": {
        "installed": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "itemPacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "collection",
          "label",
          "packageName",
          "documentName"
        ],
        "properties": {
          "collection": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "packageName": {
            "type": [
              "string",
              "null"
            ]
          },
          "documentName": {
            "const": "Item"
          }
        }
      }
    }
  }
}
